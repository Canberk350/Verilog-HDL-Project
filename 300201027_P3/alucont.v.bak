module alucont(aluop1,aluop0,f3,f2,f1,f0,gout);
input aluop1,aluop0,f3,f2,f1,f0;
output [2:0] gout;
reg [2:0] gout;

always @(aluop1 or aluop0 or f3 or f2 or f1 or f0)
begin
	if(~(aluop1|aluop0)) 			// aluop=00 & (for sw and lw and addi)
		gout=3'b110;
	if(aluop0) 				// aluop=x1 & substract (for beq and bne)
		gout=3'b100;
	if(aluop1) 				// aluop=1x & r-type
	begin
		if (~(f3|f2|f1|f0)) 		// 	f-field=0000 & add
			gout=3'b110;
		if (f0 & ~(f1)) 		// 	f-field=0001 & sll
			gout=3'b001;
		if (f1 & ~(f0)) 		// 	f-field=0010 & srl 
			gout=3'b010;
		if ((f0) & f1 & (~f2) & (~f3)) 	// 	f-field=0011 & nor 
			gout=3'b011;
		if (f2 & ~(f0)) 		// 	f-field=0100 & sub
			gout=3'b100;
		if (f2 & f0) 			// 	f-field = 0101 & or
			gout=3'b101;
		end
	end
endmodule
